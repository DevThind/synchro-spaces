# Public site URL used for canonical links and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content mode: "mock" works without credentials; "sanity" enables the CMS adapter.
NEXT_PUBLIC_CONTENT_MODE=mock
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_SECRET=
SANITY_REVALIDATE_SECRET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Cloudflare Turnstile. Leave blank to use the development verifier.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Integration selectors: "development", "hubspot" or "gohighlevel"; "development", "postmark" or "resend".
CRM_PROVIDER=development
EMAIL_PROVIDER=development
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TEAM_EMAIL=

# Optional consent-gated analytics and sanitized error monitoring.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
